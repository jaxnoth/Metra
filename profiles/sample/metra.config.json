{
  "projectsRoot": "..",
  "roots": [
    {
      "name": "work",
      "path": "..",
      "primary": true,
      "registry": "shared"
    },
    {
      "name": "personal",
      "path": "%USERPROFILE%\\iCloudDrive\\Projects",
      "optional": true,
      "cloud": true,
      "scanDepth": 0,
      "audit": "light",
      "registry": "local",
      "registryFile": "projects.personal.json"
    }
  ],
  "exclude": [
    "_metra",
    "_meta",
    "Metra",
    "metra"
  ],
  "excludeNamePatterns": [
    "node_modules",
    ".git",
    "bin",
    "obj"
  ],
  "skipFilesAtRoot": true,
  "defaultTemplate": "basic",
  "templatesDir": "templates",
  "workspace": {
    "months": 6,
    "alwaysInclude": [],
    "scanDepth": 2,
    "outputs": [
      {
        "path": "Metra.code-workspace",
        "metraFolderPath": ".",
        "projectPathPrefix": "../"
      },
      {
        "path": "../Metra.code-workspace",
        "metraFolderPath": "_metra",
        "projectPathPrefix": ""
      }
    ],
    "settings": {
      "git.autoRepositoryDetection": true,
      "git.repositoryScanMaxDepth": 1,
      "files.exclude": {
        "**/.git": true
      },
      "search.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/node_modules": true,
        "**/browser/node_modules": true,
        "**/inventory/20*/**": true,
        "**/catalog/index.json": true,
        "**/catalog/index.yaml": true,
        "**/artifacts/**/*.apm-template": true,
        "**/TicketTracker/data/**": true,
        "**/tests/results/**": true
      },
      "terminal.integrated.cwd": "${workspaceFolder:Metra}"
    },
    "extensions": {
      "recommendations": [
        "ms-vscode.powershell"
      ]
    }
  }
}

