function confidenceLabel(confidence: string): string {
  const c = (confidence || "").toLowerCase();
  if (!c || c === "high") return "";
  return ` (${c})`;
}

function copyCommandToClipboard(command: string): Promise<void> {
  if (typeof navigator === "undefined" || !navigator.clipboard?.writeText) {
    return Promise.reject(new Error("clipboard unavailable"));
  }
  return navigator.clipboard.writeText(command);
}

/** Prefer Ask Metra in chat; Copy is the optional self-serve terminal path. */
function ActionPaths({
  command,
  askPrompt,
  copyId,
}: {
  command: string;
  askPrompt: string;
  copyId: string;
}) {
  const dispatch = useCanvasAction();
  const [copiedId, setCopiedId] = useCanvasState("copiedCommandId", "");
  const copied = copiedId === copyId && Boolean(command);

  return (
    <Stack gap={8}>
      <Text size="small" weight="semibold">
        How to proceed
      </Text>
      <Text size="small" tone="secondary">
        Prefer Ask Metra - I pick this up in chat and run or investigate from there. Copy is only
        if you want to run the command yourself in a terminal.
      </Text>
      <Row gap={8} wrap>
        <Button
          variant="primary"
          onClick={() =>
            dispatch({
              type: "newComposerChat",
              userPrompt: askPrompt,
            })
          }
        >
          Ask Metra
        </Button>
        <Button
          variant="secondary"
          disabled={!command}
          onClick={() => {
            void copyCommandToClipboard(command)
              .then(() => {
                setCopiedId(copyId);
                window.setTimeout(() => {
                  setCopiedId((prev) => (prev === copyId ? "" : prev));
                }, 1500);
              })
              .catch(() => {
                setCopiedId("");
              });
          }}
        >
          {copied ? "Copied" : "Copy for terminal"}
        </Button>
      </Row>
      {command ? (
        <Text size="small" tone="tertiary">
          Terminal command: <Code>{command}</Code>
        </Text>
      ) : null}
    </Stack>
  );
}

function WhyHereList({ rows, label }: { rows: WhyHereRow[]; label: string }) {
  if (!rows || rows.length === 0) return null;
  return (
    <Stack gap={6}>
      <Text weight="semibold" size="small">
        {label}
      </Text>
      {rows.map((row) => (
        <Stack key={row.id || row.title} gap={2}>
          <Text size="small">
            {row.title}
            {confidenceLabel(row.confidence)}
            {row.id ? ` [${row.id}]` : ""}
          </Text>
          {row.decision ? (
            <Text size="small" tone="secondary">
              {row.decision}
            </Text>
          ) : null}
          {row.why ? (
            <Text size="small" tone="tertiary">
              Why: {row.why}
            </Text>
          ) : null}
        </Stack>
      ))}
    </Stack>
  );
}

function HandoffCard({
  project,
  nextCommand,
  askPrompt,
  showTicketGuidance,
  showActions = true,
}: {
  project: ProjectRow;
  nextCommand: string;
  askPrompt: string;
  showTicketGuidance: boolean;
  showActions?: boolean;
}) {
  return (
    <Card>
      <CardHeader trailing={<Pill size="sm">{project.status}</Pill>}>
        Handoff: {project.name}
      </CardHeader>
      <CardBody>
        <Stack gap={10}>
          <Stack gap={2}>
            <Text weight="semibold" size="small">
              Where?
            </Text>
            <Text size="small">
              Root {project.root || "unknown"} · {project.name}
              {project.registrySource ? ` (${project.registrySource})` : ""}
            </Text>
            <Text size="small" tone="secondary">
              Entry: {project.entry}
            </Text>
          </Stack>

          <Stack gap={2}>
            <Text weight="semibold" size="small">
              What?
            </Text>
            {project.purpose ? <Text size="small">{project.purpose}</Text> : null}
            {project.preferredPaths.length > 0 ? (
              <Text size="small" tone="secondary">
                Prefer: {project.preferredPaths.slice(0, 4).join(", ")}
              </Text>
            ) : null}
            {project.excludePaths.length > 0 ? (
              <Text size="small" tone="tertiary">
                Avoid: {project.excludePaths.slice(0, 4).join(", ")}
              </Text>
            ) : null}
            {project.capabilities.length > 0 ? (
              <Text size="small" tone="secondary">
                Capabilities: {project.capabilities.join(", ")}
              </Text>
            ) : null}
          </Stack>

          <WhyHereList rows={project.whyHere || []} label="Why?" />

          {project.serves && project.serves.length > 0 ? (
            <Stack gap={4}>
              <Text weight="semibold" size="small">
                For whom?
              </Text>
              <Row gap={6} wrap>
                {project.serves.map((s) => (
                  <Pill key={s} size="sm">
                    {s}
                  </Pill>
                ))}
              </Row>
            </Stack>
          ) : null}

          {showActions ? (
            <ActionPaths
              command={nextCommand}
              askPrompt={askPrompt}
              copyId={`handoff:${project.name}:${nextCommand}`}
            />
          ) : null}

          {showTicketGuidance ? (
            <Callout tone="info" title="Ticket-first">
              Identify with TicketTracker brief, check similar/notes/chats, then route to one
              technical project. Do not open data/tickets.json or scan sibling repos first.
            </Callout>
          ) : null}

          {project.related.length > 0 ? (
            <Text size="small" tone="tertiary">
              Related (same-root only if evidence requires): {project.related.join(", ")}
            </Text>
          ) : null}
        </Stack>
      </CardBody>
    </Card>
  );
}

export default function MetraOpsBoard() {
  const theme = useHostTheme();
  const [tab, setTab] = useCanvasState<TabId>("tab", "route");
  const [query, setQuery] = useCanvasState("recommendQuery", "");
  const [primary, setPrimary] = useCanvasState<string>("primaryProject", "");
  const [attentionId, setAttentionId] = useCanvasState<string>("attentionItem", "");
  const [rootFilter, setRootFilter] = useCanvasState<string>("rootFilter", "all");
  const [selectedName, setSelectedName] = useCanvasState<string>("selectedProject", "");

  const scored = scoreProjects(query);
  const top = scored[0];
  const runnerUp = scored[1];
  const ambiguous =
    top && runnerUp ? isAmbiguous(top.score, runnerUp.score) : false;
  const favored =
    top && runnerUp && ambiguous ? favoredTokens(query, top, runnerUp) : [];

  const lockedPrimary = SNAPSHOT.projects.find((p) => p.name === primary);
  const defaultProject =
    SNAPSHOT.projects.find((p) => p.name === SNAPSHOT.defaultEntry) ||
    SNAPSHOT.projects.find((p) => p.pinned && p.present) ||
    SNAPSHOT.projects.find((p) => p.present);

  const activePrimary = lockedPrimary || top?.project || defaultProject;
  const routePrimary = lockedPrimary || top?.project;
  const selected =
    SNAPSHOT.projects.find((p) => p.name === selectedName) || activePrimary;

  const gitChecked = Boolean(SNAPSHOT.gitChecked);
  const verifyChecked = Boolean(SNAPSHOT.verifyChecked || SNAPSHOT.verify?.checked);
  const modeLabel = SNAPSHOT.mode === "full" ? "full" : "quick";

  const attentionTodos = SNAPSHOT.todos.filter((t) => {
    if (t.kind === "git" && !gitChecked) return false;
    return true;
  });
  const decisions = SNAPSHOT.decisions;
  const contract = SNAPSHOT.contract;
  const coverage = SNAPSHOT.coverage;
  const attentionItems: AttentionItem[] = [
    ...attentionTodos.map((todo) => {
      const briefing = briefingForTodo(todo);
      return {
        id: todo.id,
        project: todo.project,
        content: todo.content,
        command: todoCommand(todo),
        source: "portfolio" as const,
        priority: todoPriority(todo),
        ...briefing,
      };
    }),
    ...(decisions?.candidates || []).map((decision) => {
      const briefing = briefingForDecision(decision);
      return {
        id: `decision:${decision.id || decision.title}`,
        project: decision.project || "",
        content: decision.title,
        command: ".\\metra.ps1 decisions show",
        source: "decision" as const,
        priority: 2,
        ...briefing,
      };
    }),
    ...(contract?.candidates || []).map((guideline) => {
      const briefing = briefingForContract(guideline);
      return {
        id: `contract:${guideline.id || guideline.text}`,
        project: "",
        content: guideline.text,
        command: ".\\metra.ps1 profile show",
        source: "contract" as const,
        priority: 3,
        ...briefing,
      };
    }),
  ].sort((a, b) => a.priority - b.priority || a.content.localeCompare(b.content));
  const visibleAttention = attentionItems.slice(0, 5);
  const selectedAttention = attentionItems.find((item) => item.id === attentionId);

  const rootOptions = [
    { value: "all", label: "All roots" },
    ...(SNAPSHOT.roots || []).map((r) => ({
      value: r.name,
      label: r.primary ? `${r.name} (primary)` : r.name,
    })),
  ];

  const filteredProjects = SNAPSHOT.projects.filter((p) => {
    if (rootFilter === "all") return true;
    return (p.root || "").toLowerCase() === rootFilter.toLowerCase();
  });

  const exceptionProjects = filteredProjects.filter(
    (p) =>
      p.drift ||
      !p.present ||
      !p.inRegistry ||
      (p.present && !p.hasAgentsMd) ||
      (gitChecked && p.gitIsRepo && (p.gitDirty > 0 || p.gitBehind > 0)),
  );

  const ctxCommand = `.\\metra.ps1 ctx -Query "${query.trim()}"`;

  const attentionProject = selectedAttention
    ? SNAPSHOT.projects.find((p) => p.name === selectedAttention.project)
    : undefined;

  // Standing routes keep the home useful when the queue is empty and nothing is typed.
  const jumpCandidates = [SNAPSHOT.defaultEntry, ...(SNAPSHOT.pinned || [])];
  const jumpProjects = jumpCandidates
    .map((name) => SNAPSHOT.projects.find((p) => p.name === name && p.present))
    .filter((p): p is ProjectRow => Boolean(p))
    .filter((p, index, list) => list.findIndex((x) => x.name === p.name) === index)
    .slice(0, 6);
  const fallbackJumps = SNAPSHOT.projects
    .filter((p) => p.present && p.inRegistry)
    .slice(0, 6);
  const standingRoutes = jumpProjects.length > 0 ? jumpProjects : fallbackJumps;
  const jumpProject =
    !query.trim() && !selectedAttention ? lockedPrimary : undefined;

  const resolutionProject = query.trim()
    ? routePrimary
    : selectedAttention
      ? attentionProject
      : jumpProject;
  const resolutionCommand = query.trim()
    ? routePrimary?.name.toLowerCase() === "tickettracker"
      ? `.\\TicketTracker.ps1 brief <id>`
      : ctxCommand
    : selectedAttention
      ? selectedAttention.command
      : jumpProject
        ? `.\\metra.ps1 routing -Name ${jumpProject.name}`
        : "";
  const resolutionAskPrompt = query.trim()
    ? routePrimary?.name.toLowerCase() === "tickettracker"
      ? `Route this ticket ask through TicketTracker first: ${query.trim()}. Start with .\\TicketTracker.ps1 brief <id>, then similar/notes/chats, then one technical project.`
      : `Help me route and resolve this ask: ${query.trim()}. Start with .\\metra.ps1 routing -Query "${query.trim()}" and continue in the primary stop.`
    : selectedAttention
      ? selectedAttention.askPrompt
      : jumpProject
        ? `I want to work in ${jumpProject.name}. Load its AGENTS.md, confirm the route with .\\metra.ps1 routing -Name ${jumpProject.name}, and tell me where to start.`
        : "";

  function clearIssue() {
    setQuery("");
    setPrimary("");
    setAttentionId("");
  }

  return (
    <Stack gap={16} style={{ padding: 16 }}>
      {/* Sticky so the tab bar stays reachable from anywhere in a long tab. */}
      <div
        style={{
          position: "sticky",
          top: 0,
          zIndex: 2,
          margin: "-16px -16px 0",
          padding: "16px 16px 10px",
          background: theme.bg.editor,
          borderBottom: `1px solid ${theme.stroke.tertiary}`,
        }}
      >
        <Stack gap={10}>
          <div
            style={{
              background: theme.fill.tertiary,
              borderLeft: `3px solid ${theme.accent.primary}`,
              padding: "14px 16px",
            }}
          >
            <Stack gap={6}>
              <Row gap={10} align="center">
                <MetraRouteMark />
                <H1>Metra Ops</H1>
              </Row>
              <Text tone="secondary" size="small">
                Find what needs you next, then route the issue to its working home.
              </Text>
              <Text tone="tertiary" size="small">
                Snapshot {modeLabel} · {generatedLabel(SNAPSHOT.generatedAt)}
              </Text>
            </Stack>
          </div>

          <Row gap={8} wrap>
            <Pill active={tab === "route"} onClick={() => setTab("route")}>
              Route
            </Pill>
            <Pill active={tab === "portfolio"} onClick={() => setTab("portfolio")}>
              Portfolio
            </Pill>
            <Pill active={tab === "stewardship"} onClick={() => setTab("stewardship")}>
              Stewardship
            </Pill>
          </Row>
        </Stack>
      </div>

      {tab === "route" ? (
        <Stack gap={16}>
          <Grid columns={2} gap={12}>
            <Card>
              <CardHeader
                trailing={
                  <Pill size="sm">
                    {visibleAttention.length} of {attentionItems.length}
                  </Pill>
                }
              >
                Needs attention
              </CardHeader>
              <CardBody>
                {visibleAttention.length > 0 ? (
                  <Stack gap={0}>
                    {visibleAttention.map((item, index) => (
                      <div
                        key={item.id}
                        style={{
                          padding: "9px 0",
                          borderBottom:
                            index < visibleAttention.length - 1
                              ? `1px solid ${theme.stroke.tertiary}`
                              : undefined,
                        }}
                      >
                        <Row gap={10} align="center" justify="space-between">
                          <Stack gap={3}>
                            <Row gap={6} align="center" wrap>
                              <Text size="small" weight="semibold">
                                {item.content}
                              </Text>
                              <Pill size="sm">{item.source}</Pill>
                            </Row>
                          </Stack>
                          <Button
                            variant={attentionId === item.id ? "primary" : "secondary"}
                            onClick={() => {
                              // Item text is evidence, not a routing query.
                              setQuery("");
                              setPrimary(item.project);
                              setAttentionId(item.id);
                            }}
                          >
                            Resolve
                          </Button>
                        </Row>
                      </div>
                    ))}
                  </Stack>
                ) : (
                  <Stack gap={8}>
                    <Text size="small" weight="semibold">
                      Nothing waiting.
                    </Text>
                    <Text size="small" tone="secondary">
                      {gitChecked
                        ? "Registry drift, git hygiene, and stewardship candidates are all clear as of this snapshot."
                        : "This quick snapshot skipped git hygiene and verify, so dirty or unpushed repos would not appear here. Run a full snapshot to re-check."}
                    </Text>
                    <ActionPaths
                      command=".\\metra.ps1 snapshot"
                      askPrompt="Run a full .\\metra.ps1 snapshot (git and verify included) and tell me what needs attention across the portfolio."
                      copyId="rescan:full-snapshot"
                    />
                  </Stack>
                )}
              </CardBody>
            </Card>

            <div
              style={{
                background: theme.fill.tertiary,
                borderLeft: `3px solid ${theme.accent.primary}`,
                padding: 16,
              }}
            >
              <Stack gap={12}>
                <Stack gap={4}>
                  <H2>Resolve this</H2>
                  {selectedAttention && !query.trim() ? (
                    <Stack gap={6}>
                      <Text weight="semibold" size="small">
                        {selectedAttention.summary}
                      </Text>
                      <Text tone="secondary" size="small">
                        {selectedAttention.detail}
                      </Text>
                      <Text tone="tertiary" size="small">
                        Done when: {selectedAttention.doneWhen}
                      </Text>
                    </Stack>
                  ) : (
                    <Text tone="secondary" size="small">
                      Describe a new symptom, ticket, or ask below - or pick Resolve on a waiting
                      item for issue-specific guidance.
                    </Text>
                  )}
                </Stack>
                <TextInput
                  value={query}
                  onChange={(value) => {
                    setQuery(value);
                    setPrimary("");
                    setAttentionId("");
                  }}
                  placeholder="e.g. orion disk alert DataOps / gateway msal / word search"
                />
                {selectedAttention && !query.trim() ? (
                  <Stack gap={8}>
                    <ActionPaths
                      command={selectedAttention.command}
                      askPrompt={selectedAttention.askPrompt}
                      copyId={`working:${selectedAttention.id}`}
                    />
                    <Row gap={8}>
                      <Button variant="ghost" onClick={clearIssue}>
                        Clear item
                      </Button>
                    </Row>
                  </Stack>
                ) : query.trim() ? (
                  <Stack gap={6}>
                    <Text size="small" tone="secondary">
                      Classification preview below. Prefer Ask Metra once a primary stop appears;
                      Copy only if you want to run the command yourself.
                    </Text>
                    <Text size="small" tone="tertiary">
                      Preview uses registry scoring; CLI evidence remains authoritative.
                    </Text>
                  </Stack>
                ) : (
                  <Text size="small" tone="tertiary">
                    Ticket work starts in {SNAPSHOT.defaultEntry}; other asks route from registry
                    triggers and project purpose.
                  </Text>
                )}
              </Stack>
            </div>
          </Grid>

          {!query.trim() && !selectedAttention && standingRoutes.length > 0 ? (
            <Card>
              <CardHeader trailing={<Pill size="sm">{standingRoutes.length}</Pill>}>
                Standing routes
              </CardHeader>
              <CardBody>
                <Stack gap={8}>
                  <Text size="small" tone="secondary">
                    No symptom to classify? Open a working home directly. Ticket work still starts
                    in {SNAPSHOT.defaultEntry}.
                  </Text>
                  <Row gap={8} wrap>
                    {standingRoutes.map((p) => (
                      <Pill
                        key={p.name}
                        active={primary === p.name}
                        onClick={() => {
                          setAttentionId("");
                          setPrimary(primary === p.name ? "" : p.name);
                        }}
                      >
                        {p.name}
                      </Pill>
                    ))}
                  </Row>
                </Stack>
              </CardBody>
            </Card>
          ) : null}

          <CollapsibleSection title="Start here" defaultOpen={false}>
            <Stack gap={4}>
              <Text size="small">Pick Resolve on a waiting item for an issue-specific briefing.</Text>
              <Text size="small">
                Prefer Ask Metra so I continue in chat. Copy for terminal only if you want to run
                the command yourself.
              </Text>
              <Text size="small" tone="tertiary">
                This board retrieves from routing, portfolio, and stewardship homes. Durable
                changes still happen in chat or the CLI.
              </Text>
            </Stack>
          </CollapsibleSection>

          {query.trim() || selectedAttention || jumpProject ? (
            <Stack gap={12}>
              <Divider />
              <H2>Resolution path</H2>
              {!query.trim() && selectedAttention ? (
                <Text size="small" tone="secondary">
                  Needs attention → {selectedAttention.project || "Stewardship"} → next action
                </Text>
              ) : null}
              {jumpProject ? (
                <Row gap={8} align="center" wrap>
                  <Text size="small" tone="secondary">
                    Standing route → {jumpProject.name} → next action
                  </Text>
                  <Button variant="ghost" onClick={clearIssue}>
                    Clear route
                  </Button>
                </Row>
              ) : null}
              {query.trim() && top ? (
                <Stack gap={8}>
                  <Text size="small" tone="secondary">
                    Request → {top.project.name}
                    {ambiguous && runnerUp ? ` (close with ${runnerUp.project.name})` : ""} →
                    next action
                  </Text>
                  <Row gap={8} wrap>
                    {scored.slice(0, 5).map((s) => (
                      <Pill
                        key={s.project.name}
                        active={
                          (primary || top.project.name) === s.project.name
                        }
                        onClick={() => setPrimary(s.project.name)}
                      >
                        {s.project.name} · {s.score}
                      </Pill>
                    ))}
                  </Row>
                </Stack>
              ) : query.trim() ? (
                <Callout tone="warning" title="No route match">
                  No present registry project scored for that query. Try different triggers, or
                  run .\metra.ps1 routing -Query in chat.
                </Callout>
              ) : null}

              {resolutionProject ? (
                <HandoffCard
                  project={resolutionProject}
                  nextCommand={resolutionCommand}
                  askPrompt={resolutionAskPrompt}
                  showTicketGuidance={
                    resolutionProject.name.toLowerCase() === "tickettracker"
                  }
                  showActions={Boolean(query.trim()) || !selectedAttention}
                />
              ) : selectedAttention ? (
                <Callout tone="info" title={selectedAttention.content}>
                  <Stack gap={8}>
                    <Text size="small">{selectedAttention.summary}</Text>
                    <Text size="small" tone="secondary">
                      {selectedAttention.detail}
                    </Text>
                    <ActionPaths
                      command={selectedAttention.command}
                      askPrompt={selectedAttention.askPrompt}
                      copyId={`orphan:${selectedAttention.id}`}
                    />
                  </Stack>
                </Callout>
              ) : null}

              {query.trim() && ambiguous && runnerUp ? (
                <Callout tone="warning" title={`Why not? ${runnerUp.project.name}`}>
                  <Stack gap={6}>
                    {favored.length > 0 ? (
                      <Text size="small">
                        Query tokens favored the primary for: {favored.join(", ")}
                      </Text>
                    ) : null}
                    {(runnerUp.project.whyHere || []).length > 0 ? (
                      <WhyHereList
                        rows={runnerUp.project.whyHere}
                        label={`Ledger context for ${runnerUp.project.name}`}
                      />
                    ) : (
                      <Text size="small" tone="secondary">
                        Scores are close. Confirm with .\metra.ps1 routing -Query before
                        opening a second project.
                      </Text>
                    )}
                  </Stack>
                </Callout>
              ) : null}
            </Stack>
          ) : null}
        </Stack>
      ) : null}

      {tab === "portfolio" ? (
        <Stack gap={16}>
          <Row gap={8} wrap align="center">
            <Pill size="sm">{modeLabel} snapshot</Pill>
            {!gitChecked ? (
              <Pill size="sm">git not checked</Pill>
            ) : null}
            {!verifyChecked ? (
              <Pill size="sm">verify not checked</Pill>
            ) : (
              <Pill
                size="sm"
                active={SNAPSHOT.verify?.status === "PASS"}
                tone={
                  SNAPSHOT.verify?.status === "FAIL"
                    ? "warning"
                    : SNAPSHOT.verify?.status === "WARN"
                      ? "warning"
                      : "neutral"
                }
              >
                verify {SNAPSHOT.verify?.status}
              </Pill>
            )}
          </Row>

          <Grid columns={3} gap={12}>
            <Stat
              value={String(SNAPSHOT.driftCount)}
              label="Drift signals"
              tone={SNAPSHOT.driftCount > 0 ? "warning" : "success"}
            />
            <Stat
              value={String(attentionTodos.length)}
              label="Needs attention"
              tone={attentionTodos.length > 0 ? "warning" : "success"}
            />
            <Stat
              value={String(SNAPSHOT.projectCount)}
              label="Projects"
            />
          </Grid>

          {gitChecked ? (
            <Row gap={8} wrap>
              <Stat
                value={String(SNAPSHOT.gitDirtyProjects)}
                label="Git dirty projects"
                tone={SNAPSHOT.gitDirtyProjects > 0 ? "warning" : "success"}
              />
              <Stat
                value={String(SNAPSHOT.gitBehindProjects)}
                label="Behind remote"
                tone={SNAPSHOT.gitBehindProjects > 0 ? "warning" : undefined}
              />
              <Stat
                value={String(SNAPSHOT.missingAgents)}
                label="Missing AGENTS.md"
                tone={SNAPSHOT.missingAgents > 0 ? "warning" : "success"}
              />
            </Row>
          ) : (
            <Callout tone="info" title="Quick snapshot">
              Git and verify were not checked. Run .\metra.ps1 snapshot (full) for those
              conclusions.
            </Callout>
          )}

          {attentionTodos.length > 0 ? (
            <Card>
              <CardHeader>Needs attention</CardHeader>
              <CardBody>
                <Stack gap={6}>
                  {attentionTodos.slice(0, 12).map((t) => (
                    <Text key={t.id} size="small">
                      {t.content}
                    </Text>
                  ))}
                </Stack>
              </CardBody>
            </Card>
          ) : (
            <Callout tone="success" title="Nothing urgent">
              No drift or hygiene items in the current snapshot.
            </Callout>
          )}

          <Divider />
          <H2>Projects</H2>
          <Row gap={8} wrap align="center">
            <Select
              value={rootFilter}
              onChange={setRootFilter}
              options={rootOptions}
            />
            <Text size="small" tone="tertiary">
              Cross-root related projects are labeled; never auto-handoff across roots.
            </Text>
          </Row>

          <Table
            headers={["Project", "Root", "Status", "Audience", "Notes"]}
            rows={exceptionProjects.slice(0, 30).map((p) => [
              p.name,
              p.root || "",
              p.status,
              (p.serves || []).slice(0, 2).join(", "),
              p.findings.slice(0, 1).join("; ") ||
                (gitChecked && p.gitSummary !== "n/a" && p.gitSummary !== "skipped"
                  ? p.gitSummary
                  : ""),
            ])}
            rowTone={exceptionProjects.slice(0, 30).map((p) =>
              p.drift || !p.present ? ("warning" as const) : ("info" as const),
            )}
            striped
            stickyHeader
          />

          <CollapsibleSection
            title="All projects"
            count={filteredProjects.length}
            defaultOpen={exceptionProjects.length === 0}
          >
            <Stack gap={8}>
              <Row gap={6} wrap>
                {filteredProjects.map((p) => (
                  <Pill
                    key={p.name}
                    active={selected?.name === p.name}
                    onClick={() => setSelectedName(p.name)}
                  >
                    {p.name}
                  </Pill>
                ))}
              </Row>
            </Stack>
          </CollapsibleSection>

          {selected ? (
            <Card>
              <CardHeader
                trailing={
                  <Button variant="secondary" onClick={() => setPrimary(selected.name)}>
                    Use as route primary
                  </Button>
                }
              >
                {selected.name}
              </CardHeader>
              <CardBody>
                <Stack gap={8}>
                  <Text size="small">{selected.purpose || "No purpose in registry."}</Text>
                  <Text size="small" tone="secondary">
                    Root {selected.root || "unknown"} · status {selected.status} · entry{" "}
                    {selected.entry}
                  </Text>
                  {selected.serves?.length ? (
                    <Text size="small">For whom: {selected.serves.join(", ")}</Text>
                  ) : null}
                  {selected.related.length ? (
                    <Text size="small" tone="tertiary">
                      Related: {selected.related.join(", ")}
                    </Text>
                  ) : null}
                  <WhyHereList rows={selected.whyHere || []} label="Why here?" />
                </Stack>
              </CardBody>
            </Card>
          ) : null}
        </Stack>
      ) : null}

      {tab === "stewardship" ? (
        <Stack gap={16}>
          <Card>
            <CardHeader>Portfolio Operating Model</CardHeader>
            <CardBody>
              <Stack gap={4}>
                <Text size="small">Where? · Routing</Text>
                <Text size="small">What? · Context</Text>
                <Text size="small">Why? · Decisions</Text>
                <Text size="small">How? · Communication</Text>
                <Text size="small">For whom? · Serves</Text>
                <Spacer />
                <Text size="small" tone="tertiary">
                  This board retrieves from those homes. It is not a second home.
                </Text>
              </Stack>
            </CardBody>
          </Card>

          <Callout tone="neutral" title="Audience boundary">
            Roles, teams, and consumer systems are allowed. Individual profiling is not.
            Ticket requester facts stay in TicketTracker evidence.
          </Callout>

          {coverage ? (
            <Grid columns={3} gap={12}>
              <Stat
                value={String(coverage.projectsWithServes)}
                label="Projects with serves"
              />
              <Stat
                value={String(coverage.confirmedDecisionCount)}
                label="Confirmed decisions"
              />
              <Stat
                value={String(coverage.confirmedGuidelineCount)}
                label="OCC guidelines"
              />
            </Grid>
          ) : null}

          <H2>Decision Registry</H2>
          {decisions?.ledgerExists === false ? (
            <Text size="small" tone="secondary">
              No local Decision Registry yet. Use .\metra.ps1 decisions note / harvest /
              promote.
            </Text>
          ) : (
            <Stack gap={10}>
              <Text size="small" tone="secondary">
                {decisions?.confirmedCount ?? 0} confirmed · {decisions?.candidateCount ?? 0}{" "}
                candidates · max {decisions?.maxConfirmed ?? 50}
              </Text>
              {(decisions?.recent || []).length > 0 ? (
                <Card>
                  <CardHeader>Recent decisions</CardHeader>
                  <CardBody>
                    <Stack gap={8}>
                      {decisions!.recent.map((d) => (
                        <Stack key={d.id || d.title} gap={2}>
                          <Text size="small" weight="semibold">
                            {d.title}
                            {d.project ? ` · ${d.project}` : ""}
                          </Text>
                          {d.decision ? (
                            <Text size="small" tone="secondary">
                              {d.decision}
                            </Text>
                          ) : null}
                        </Stack>
                      ))}
                    </Stack>
                  </CardBody>
                </Card>
              ) : null}
              {(decisions?.candidates || []).length > 0 ? (
                <Card>
                  <CardHeader>Candidates awaiting review</CardHeader>
                  <CardBody>
                    <Stack gap={6}>
                      {decisions!.candidates.map((c) => (
                        <Text key={c.id || c.title} size="small">
                          {c.title}
                          {c.project ? ` · ${c.project}` : ""}
                        </Text>
                      ))}
                      <Text size="small" tone="tertiary">
                        Promote with .\metra.ps1 decisions promote (requires why,
                        confidence, evidence).
                      </Text>
                    </Stack>
                  </CardBody>
                </Card>
              ) : null}
            </Stack>
          )}

          <Divider />
          <H2>Operator Communication Contract</H2>
          {contract?.ledgerExists === false && (contract?.confirmedCount ?? 0) === 0 ? (
            <Text size="small" tone="secondary">
              No confirmed guidelines yet. Soft preferences go through .\metra.ps1 profile
              note / promote.
            </Text>
          ) : (
            <Stack gap={10}>
              <Text size="small" tone="secondary">
                {contract?.confirmedCount ?? 0} confirmed · {contract?.candidateCount ?? 0}{" "}
                candidates · max {contract?.maxConfirmed ?? 20}
              </Text>
              {(contract?.confirmed || []).length > 0 ? (
                <Card>
                  <CardHeader>Confirmed guidelines</CardHeader>
                  <CardBody>
                    <Stack gap={6}>
                      {contract!.confirmed.map((g) => (
                        <Text key={g.id || g.text} size="small">
                          {g.text}
                        </Text>
                      ))}
                    </Stack>
                  </CardBody>
                </Card>
              ) : null}
              {(contract?.candidates || []).length > 0 ? (
                <Card>
                  <CardHeader>Pending candidates</CardHeader>
                  <CardBody>
                    <Stack gap={6}>
                      {contract!.candidates.map((g) => (
                        <Text key={g.id || g.text} size="small">
                          {g.text}
                        </Text>
                      ))}
                      <Text size="small" tone="tertiary">
                        Confirm with .\metra.ps1 profile promote. Portfolio-wide rules
                        refuse personal promote.
                      </Text>
                    </Stack>
                  </CardBody>
                </Card>
              ) : null}
            </Stack>
          )}
        </Stack>
      ) : null}
    </Stack>
  );
}
