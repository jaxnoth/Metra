type TabId = "route" | "portfolio" | "stewardship";

type Scored = {
  project: ProjectRow;
  score: number;
  matchedTokens: string[];
  hayLower: string;
};

function tokenize(query: string): string[] {
  return query
    .toLowerCase()
    .split(/\W+/)
    .map((t) => t.trim())
    .filter((t) => t.length > 1);
}

/** Matches Get-MetraScoredRoutingProjects: present registry projects only. */
function scoreProjects(query: string): Scored[] {
  const tokens = tokenize(query);
  if (tokens.length === 0) return [];
  const scored: Scored[] = [];
  for (const project of SNAPSHOT.projects) {
    if (!project.inRegistry || !project.present) continue;
    const hay = [project.name, ...project.triggers, project.purpose].join(" ");
    const hayLower = hay.toLowerCase();
    let score = 0;
    const matchedTokens: string[] = [];
    for (const token of tokens) {
      if (hayLower.includes(token)) {
        score += 1;
        if (!matchedTokens.includes(token)) matchedTokens.push(token);
      }
      if (project.name.toLowerCase() === token) score += 2;
    }
    if (score <= 0) continue;
    scored.push({ project, score, matchedTokens, hayLower });
  }
  return scored.sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return a.project.name.localeCompare(b.project.name);
  });
}

/** Matches Test-MetraRoutingAmbiguity. */
function isAmbiguous(primaryScore: number, runnerUpScore: number): boolean {
  if (runnerUpScore <= 0) return false;
  if (primaryScore - runnerUpScore <= 1) return true;
  if (primaryScore >= 2 && runnerUpScore >= Math.ceil(primaryScore * 0.5)) return true;
  return false;
}

function favoredTokens(query: string, primary: Scored, runnerUp: Scored): string[] {
  const tokens = tokenize(query);
  const exclusive = tokens.filter(
    (t) => primary.hayLower.includes(t) && !runnerUp.hayLower.includes(t),
  );
  if (exclusive.length > 0) return exclusive;
  return [...new Set(primary.matchedTokens)];
}

function generatedLabel(iso: string): string {
  if (!iso || iso === "pending") return "snapshot pending - run .\\metra.ps1 snapshot";
  try {
    return new Date(iso).toLocaleString();
  } catch {
    return iso;
  }
}

function quoteName(name: string): string {
  return `"${name.replace(/"/g, '""')}"`;
}

function todoCommand(todo: MetaTodo): string {
  if (todo.kind === "verify") return ".\\metra.ps1 verify";
  if (todo.kind === "git") {
    return `.\\metra.ps1 status -Name ${quoteName(todo.project)}`;
  }
  if (todo.project) {
    return `.\\metra.ps1 audit -Name ${quoteName(todo.project)}`;
  }
  return ".\\metra.ps1 audit -DriftOnly";
}

function todoPriority(todo: MetaTodo): number {
  if (todo.kind === "verify") return 0;
  if (todo.kind === "drift") return 1;
  if (todo.kind === "git") return 4;
  return 2;
}

function briefingForTodo(todo: MetaTodo): Pick<
  AttentionItem,
  "kind" | "summary" | "detail" | "doneWhen" | "askPrompt"
> {
  const project = todo.project || "the portfolio";
  const lower = (todo.content || "").toLowerCase();
  if (todo.kind === "verify") {
    return {
      kind: "verify",
      summary: "Installation smoke is not clean.",
      detail:
        "Verify checks routing fixtures, sample profile preview, and audit drift signals. Fix FAIL rows before trusting routing smoke.",
      doneWhen: `.\\metra.ps1 verify reports PASS with no FAIL rows.`,
      askPrompt: `Help me clear Metra verify findings from the Ops board. Start with .\\metra.ps1 verify and walk the FAIL/WARN rows.`,
    };
  }
  if (todo.kind === "git") {
    const dirty = lower.includes("dirty");
    const behind = lower.includes("behind");
    const ahead = lower.includes("ahead");
    let summary = `${project} has git drift relative to its remote.`;
    if (dirty && ahead) summary = `${project} has local uncommitted changes and commits not pushed.`;
    else if (dirty) summary = `${project} has local uncommitted changes.`;
    else if (behind) summary = `${project} is behind its remote.`;
    else if (ahead) summary = `${project} has local commits not pushed.`;
    return {
      kind: "git",
      summary,
      detail:
        "This is hygiene, not a routing failure. Inspect status, decide whether to commit, stash, pull, or push. Do not invent a commit unless asked.",
      doneWhen: `.\\metra.ps1 status -Name ${quoteName(project)} shows a clean working tree for the concern listed.`,
      askPrompt: `Help me resolve this Metra Ops attention item for ${project}: ${todo.content}. Inspect git status and recommend the next safe step. Do not commit unless I ask.`,
    };
  }
  if (lower.includes("missing from registry")) {
    return {
      kind: "drift",
      summary: `${project} exists on disk but is not in the Metra registry.`,
      detail:
        "Routing will not treat it as a first-class stop until it is registered (or intentionally left out). Prefer projects.local.json for machine-private entries; projects.json only for shared stubs.",
      doneWhen: `${project} is either registered with purpose/triggers or intentionally excluded and no longer flagged.`,
      askPrompt: `Help me resolve this Metra Ops attention item: ${todo.content}. Decide whether to register ${project} in projects.local.json or leave it out, then propose the concrete edit.`,
    };
  }
  if (lower.includes(".cursorignore")) {
    return {
      kind: "drift",
      summary: `${project} is missing a .cursorignore file.`,
      detail:
        "Without ignore rules, agents may load generated noise. Prefer the project's AGENTS.md excludePaths and sibling patterns before inventing a broad ignore.",
      doneWhen: `${project} has a .cursorignore aligned with its excludePaths, or audit no longer flags it.`,
      askPrompt: `Help me resolve this Metra Ops attention item: ${todo.content}. Propose a .cursorignore for ${project} based on AGENTS.md excludePaths and common generated folders.`,
    };
  }
  if (lower.includes("agents.md")) {
    return {
      kind: "drift",
      summary: `${project} is missing AGENTS.md.`,
      detail:
        "AGENTS.md is the agent entry for route-here triggers, preferred paths, and token rules. Without it, agents fall back to README and may scan too broadly.",
      doneWhen: `${project}/AGENTS.md exists with Route here / Start here / Token rules sections.`,
      askPrompt: `Help me resolve this Metra Ops attention item: ${todo.content}. Draft AGENTS.md for ${project} from its README and registry purpose.`,
    };
  }
  return {
    kind: todo.kind === "drift" ? "drift" : "other",
    summary: todo.content,
    detail:
      "Portfolio audit flagged this item. Confirm the finding, then repair the registry, docs, or project layout so routing stays trustworthy.",
    doneWhen: "A fresh snapshot no longer lists this attention item.",
    askPrompt: `Help me resolve this Metra Ops attention item: ${todo.content}. Start with .\\metra.ps1 audit${todo.project ? ` -Name ${quoteName(todo.project)}` : " -DriftOnly"} and propose the smallest fix.`,
  };
}

function briefingForDecision(decision: DecisionBrief): Pick<
  AttentionItem,
  "kind" | "summary" | "detail" | "doneWhen" | "askPrompt"
> {
  return {
    kind: "decision",
    summary: `Decision candidate needs review: ${decision.title}`,
    detail:
      decision.decision ||
      "Harvested or noted candidate only. Promotion requires why, confidence, and evidence - never auto-promote.",
    doneWhen:
      "Candidate is promoted with why/confidence/evidence, superseded, or forgotten after review.",
    askPrompt: `Help me review this Metra Decision Registry candidate: ${decision.title}${decision.project ? ` (${decision.project})` : ""}. Start with .\\metra.ps1 decisions show and recommend promote, revise, or forget.`,
  };
}

function briefingForContract(guideline: ContractBrief): Pick<
  AttentionItem,
  "kind" | "summary" | "detail" | "doneWhen" | "askPrompt"
> {
  return {
    kind: "contract",
    summary: "Operator Communication Contract candidate needs confirmation.",
    detail: guideline.text,
    doneWhen:
      "Guideline is promoted (soft preference only) or discarded. Portfolio-wide rules refuse personal promote.",
    askPrompt: `Help me review this Metra Operator Communication Contract candidate: ${guideline.text}. Start with .\\metra.ps1 profile show and recommend promote or forget.`,
  };
}

