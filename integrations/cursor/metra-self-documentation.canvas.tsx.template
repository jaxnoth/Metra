function DiagramFrame({
  title,
  caption,
  width,
  height,
  children,
}: {
  title: string;
  caption: string;
  width: number;
  height: number;
  children?: unknown;
}) {
  const theme = useHostTheme();
  return (
    <Stack gap={8}>
      <H3>{title}</H3>
      <div
        style={{
          background: theme.bg.elevated,
          border: `1px solid ${theme.stroke.secondary}`,
          borderRadius: 8,
          padding: 12,
          overflow: "auto",
        }}
      >
        <svg
          width="100%"
          viewBox={`0 0 ${width} ${height}`}
          role="img"
          aria-label={title}
          style={{ display: "block", maxWidth: width }}
        >
          {children}
        </svg>
      </div>
      <Text size="small" tone="secondary">
        {caption}
      </Text>
    </Stack>
  );
}

function RouteDiagram() {
  const theme = useHostTheme();
  const homes = SELFDOC_ROUTES.diagram.length
    ? SELFDOC_ROUTES.diagram
    : [
        {
          id: "tickettracker",
          name: "TicketTracker",
          sampleAsk: "ticket",
          purpose: "",
          triggers: [] as string[],
        },
      ];
  const layout = computeDAGLayout({
    nodes: [{ id: "ask" }, ...homes.map((h) => ({ id: h.id }))],
    edges: homes.map((h) => ({ from: "ask", to: h.id })),
    direction: "vertical",
    nodeWidth: 140,
    nodeHeight: 44,
    rankGap: 56,
    nodeGap: 28,
    padding: 16,
  });

  const labels: Record<string, string> = { ask: "Ask" };
  for (const h of homes) {
    labels[h.id] = h.name;
  }
  const chosen =
    SELFDOC_ROUTES.chosenId && labels[SELFDOC_ROUTES.chosenId]
      ? SELFDOC_ROUTES.chosenId
      : homes[0]?.id ?? "ask";

  return (
    <DiagramFrame
      title="Ask lands in one project home"
      caption={`Registry-driven diagram. Refresh with .\\metra.ps1 selfdoc (${SELFDOC_ROUTES.generatedAt || "not yet generated"}).`}
      width={layout.width}
      height={layout.height}
    >
      {layout.edges.map((e) => {
        const active = e.to === chosen;
        return (
          <line
            key={`${e.from}-${e.to}`}
            x1={e.sourceX}
            y1={e.sourceY}
            x2={e.targetX}
            y2={e.targetY}
            stroke={active ? theme.accent.primary : theme.stroke.tertiary}
            strokeWidth={active ? 3 : 2}
            strokeDasharray={active ? undefined : "6 5"}
            opacity={active ? 1 : 0.55}
          />
        );
      })}
      {layout.nodes.map((n) => {
        const active = n.id === "ask" || n.id === chosen;
        return (
          <g key={n.id}>
            <rect
              x={n.x}
              y={n.y}
              width={140}
              height={44}
              rx={8}
              fill={active ? theme.fill.secondary : theme.bg.chrome}
              stroke={active ? theme.accent.primary : theme.stroke.secondary}
              strokeWidth={active ? 2.5 : 1.5}
            />
            <text
              x={n.x + 70}
              y={n.y + 28}
              textAnchor="middle"
              fill={theme.text.primary}
              fontSize={14}
              fontWeight={active ? 700 : 500}
              fontFamily="system-ui, sans-serif"
            >
              {labels[n.id] ?? n.id}
            </text>
          </g>
        );
      })}
    </DiagramFrame>
  );
}

function StackDiagram() {
  const theme = useHostTheme();
  const layout = computeDAGLayout({
    nodes: [
      { id: "cli" },
      { id: "tray" },
      { id: "ops" },
      { id: "ask" },
      { id: "cursor" },
    ],
    edges: [
      { from: "cli", to: "tray" },
      { from: "tray", to: "ops" },
      { from: "ops", to: "ask" },
      { from: "ops", to: "cursor" },
    ],
    direction: "vertical",
    nodeWidth: 168,
    nodeHeight: 48,
    rankGap: 40,
    nodeGap: 36,
    padding: 16,
  });

  const labels: Record<string, { title: string; sub: string }> = {
    cli: { title: "metra.ps1", sub: "CLI core - works alone" },
    tray: { title: "Tray host", sub: "Optional - keeps desk alive" },
    ops: { title: "Ops desk", sub: "HTML home screen" },
    ask: { title: "Ask engine", sub: "Answer-only AI" },
    cursor: { title: "Cursor / editor", sub: "Build when asked" },
  };

  return (
    <DiagramFrame
      title="Thin stack - clear owners"
      caption="CLI is the product core. Ops Ask answers; the editor builds. Cursor is one swappable engine - not Metra."
      width={Math.max(layout.width, 420)}
      height={layout.height + 8}
    >
      {layout.edges.map((e) => (
        <line
          key={`${e.from}-${e.to}`}
          x1={e.sourceX}
          y1={e.sourceY}
          x2={e.targetX}
          y2={e.targetY}
          stroke={theme.stroke.secondary}
          strokeWidth={2}
        />
      ))}
      {layout.nodes.map((n) => {
        const meta = labels[n.id];
        const isCore = n.id === "cli";
        return (
          <g key={n.id}>
            <rect
              x={n.x}
              y={n.y}
              width={168}
              height={48}
              rx={8}
              fill={isCore ? theme.fill.secondary : theme.bg.chrome}
              stroke={isCore ? theme.accent.primary : theme.stroke.secondary}
              strokeWidth={isCore ? 2.5 : 1.5}
            />
            <text
              x={n.x + 84}
              y={n.y + 20}
              textAnchor="middle"
              fill={theme.text.primary}
              fontSize={13}
              fontWeight={700}
              fontFamily="system-ui, sans-serif"
            >
              {meta.title}
            </text>
            <text
              x={n.x + 84}
              y={n.y + 36}
              textAnchor="middle"
              fill={theme.text.secondary}
              fontSize={11}
              fontFamily="system-ui, sans-serif"
            >
              {meta.sub}
            </text>
          </g>
        );
      })}
    </DiagramFrame>
  );
}

