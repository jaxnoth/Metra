{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "routing-context.result",
  "type": "object",
  "required": ["schemaVersion", "registryName", "root", "routingConfidence", "routingEvidence", "minimumConfidence", "eligible"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "registryName": { "type": "string" },
    "root": { "type": "string" },
    "routingConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "routingEvidence": { "type": "string" },
    "minimumConfidence": { "type": "number" },
    "eligible": { "type": "boolean" }
  },
  "additionalProperties": false
}
