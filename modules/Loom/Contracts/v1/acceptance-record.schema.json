{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "acceptance-record",
  "type": "object",
  "required": ["schemaVersion", "itemId", "acceptedAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "recordProfile": { "type": "string" },
    "itemId": { "type": "string" },
    "acceptanceOutcome": { "type": "string" },
    "operator": { "type": "string" },
    "acceptedAt": { "type": "string" },
    "branch": { "type": "string" },
    "completedCommit": { "type": "string" },
    "baselineCommit": { "type": "string" },
    "verifyOutcome": { "type": "string" },
    "packDiffPath": { "type": "string" },
    "formalPlanPath": { "type": "string" },
    "todoOrSlice": { "type": "string" },
    "manualTestComplete": { "type": "boolean" },
    "completionCycleId": { "type": "string" },
    "override": { "type": "object" },
    "merge": { "type": "object" }
  }
}
