{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pack-diff-manifest",
  "type": "object",
  "required": ["schemaVersion", "reviewDate", "generatedAtUtc", "projects"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "reviewDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generatedAtUtc": { "type": "string" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["registryName", "projectKey", "projectRoot", "items"],
        "properties": {
          "registryName": { "type": "string" },
          "projectKey": { "type": "string" },
          "projectRoot": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "itemId",
                "baselineCommit",
                "completedCommit",
                "completionCycleId",
                "packDiffPath",
                "bingPackPath"
              ],
              "properties": {
                "itemId": { "type": "string" },
                "completionTransitionAt": { "type": "string" },
                "baselineCommit": { "type": "string" },
                "completedCommit": { "type": "string" },
                "branch": { "type": "string" },
                "packDiffPath": { "type": "string" },
                "bingPackPath": { "type": "string" },
                "verifyOutcome": { "type": "string" },
                "completionCycleId": { "type": "string" }
              }
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["itemId", "reason"],
              "properties": {
                "itemId": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "skippedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["itemId", "reason"],
        "properties": {
          "itemId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
