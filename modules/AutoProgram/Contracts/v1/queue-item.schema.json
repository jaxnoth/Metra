{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "queue-item",
  "type": "object",
  "required": ["schemaVersion", "id", "summary", "status", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^AP-\\d{8}-\\d{4}$" },
    "summary": { "type": "string" },
    "status": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
