{
  "projectsRoot": "..",
  "roots": [
    {
      "name": "work",
      "path": "..",
      "primary": true,
      "registry": "shared"
    }
  ],
  "exclude": [
    "_metra",
    "_meta",
    "Metra",
    "metra"
  ],
  "excludeNamePatterns": [
    "node_modules",
    ".git",
    "bin",
    "obj"
  ],
  "skipFilesAtRoot": true,
  "defaultTemplate": "basic",
  "templatesDir": "templates",
  "ask": {
    "enabled": true,
    "engine": "ollama",
    "ollama": {
      "baseUrl": "http://127.0.0.1:11434",
      "model": "qwen2.5:7b",
      "sizeBand": "medium"
    },
    "cursor": {
      "port": 7381,
      "model": "composer-2.5"
    },
    "llamacpp": {
      "baseUrl": "http://127.0.0.1:8080",
      "model": "qwen2.5:14b"
    }
  },
  "workspace": {
    "months": 6,
    "alwaysInclude": [],
    "exclude": [],
    "scanDepth": 2,
    "outputs": [
      {
        "path": "Metra.code-workspace",
        "metraFolderPath": ".",
        "projectPathPrefix": "../"
      }
    ],
    "settings": {
      "git.autoRepositoryDetection": true,
      "git.repositoryScanMaxDepth": 1,
      "files.exclude": {
        "**/.git": true
      },
      "search.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/node_modules": true,
        "**/browser/node_modules": true,
        "**/inventory/20*/**": true,
        "**/catalog/index.json": true,
        "**/catalog/index.yaml": true,
        "**/artifacts/**/*.apm-template": true,
        "**/TicketTracker/data/**": true,
        "**/tests/results/**": true
      },
      "terminal.integrated.cwd": "${workspaceFolder:Metra}"
    },
    "extensions": {
      "recommendations": [
        "ms-vscode.powershell"
      ]
    }
  }
}

